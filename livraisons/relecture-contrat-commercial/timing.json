 "vo": [
  {
   "scene": "sc01",
   "start": 0.31,
   "end": 4.157,
   "text": "Relecture de contrat commercial : un client ou un fournisseur vous soumet son contrat ?",
   "section": null
  },
  {
   "scene": "sc02",
   "start": 4.887,
   "end": 9.337,
   "text": "Attention : son contrat est rédigé pour lui, pour protéger ses intérêts. Pas pour vous.",
   "section": "01 · Le problème"
  },
  {
   "scene": "sc03",
   "start": 10.067,
   "end": 15.437,
   "text": "Les clauses qui coûtent le plus cher en cas de problème : la responsabilité, les pénalités, la durée et le for.",
   "section": "01 · Le problème"
  },
  {
   "scene": "sc04",
   "start": 16.167,
   "end": 21.423,
   "text": "On relit tout le contrat, on classe les risques par priorité, et on propose des corrections en suivi des modifications.",
   "section": "02 · La solution"
  },
  {
   "scene": "sc05",
   "start": 22.153,
   "end": 26.684,
   "text": "Vous négociez avec une liste claire, point par point. Et la relecture en anglais est possible.",
   "section": "02 · La solution"
  },
  {
   "scene": "sc06",
   "start": 27.414,
   "end": 34.965,
   "text": "Vous décrivez votre situation en ligne. Chaque dossier est analysé et recherché, jamais improvisé. Et vous recevez votre relecture, par écrit.",
   "section": "02 · La solution"
  },
  {
   "scene": "sc07",
   "start": 35.695,
   "end": 44.015,
   "text": "Un prix fixe, annoncé avant de commencer. Tout se fait par écrit. Tout est recherché, jamais improvisé. Et si un avocat est nécessaire, on vous le dit.",
   "section": "02 · La solution"
  },
  {
   "scene": "sc08",
   "start": 44.745,
   "end": 48.865,
   "text": "Commandez en ligne, sur la page de la prestation. Le lien est dans la description.",
   "section": "03 · Commander"
  }
 ]
