 "vo": [
  {
   "scene": "sc01",
   "start": 0.55,
   "end": 6.04,
   "text": "Appel juridique : vous préférez en parler, par téléphone ou en visio ?",
   "section": null
  },
  {
   "scene": "sc02",
   "start": 7.29,
   "end": 15.63,
   "text": "Face à un problème juridique, le plus dur, c’est souvent de savoir par où commencer. Et surtout, quels délais respecter.",
   "section": "01 · Le problème"
  },
  {
   "scene": "sc03",
   "start": 16.88,
   "end": 24.64,
   "text": "Vous exposez votre situation. On vous dit ce que vous pouvez faire, dans quels délais, et ce qu’il faut éviter.",
   "section": "01 · Le problème"
  },
  {
   "scene": "sc04",
   "start": 25.89,
   "end": 33.88,
   "text": "L’appel est préparé à partir de votre description écrite, et vous recevez ensuite un résumé écrit des prochaines étapes.",
   "section": "02 · La solution"
  },
  {
   "scene": "sc05",
   "start": 35.13,
   "end": 41.14,
   "text": "Et si votre situation demande plus, le résumé indique la prestation adaptée, à prix fixe.",
   "section": "02 · La solution"
  },
  {
   "scene": "sc06",
   "start": 42.39,
   "end": 52.76,
   "text": "Vous décrivez votre situation en ligne. Chaque dossier est analysé et recherché, jamais improvisé. Et vous recevez votre résumé, par écrit.",
   "section": "02 · La solution"
  },
  {
   "scene": "sc07",
   "start": 54.01,
   "end": 66.02,
   "text": "Un prix fixe, annoncé avant de commencer. Tout se fait par écrit. Tout est recherché, jamais improvisé. Et si un avocat est nécessaire, on vous le dit.",
   "section": "02 · La solution"
  },
  {
   "scene": "sc08",
   "start": 67.27,
   "end": 72.96,
   "text": "Commandez en ligne, sur la page de la prestation. Le lien est dans la description.",
   "section": "03 · Commander"
  }
 ]
