# En-têtes des fichiers statiques (Cloudflare Workers Assets).
# Les fichiers de /_next/static portent un hash dans leur nom : cache d'un an, sans revalidation.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Images, logos et affiches vidéo : un mois, avec revalidation ensuite.
/media/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/logo/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

# Sécurité de base sur les fichiers servis directement.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
